generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model enfermedad {
  id             Int              @id @default(autoincrement())
  tipo           String           @db.VarChar(255)
  descripcion    String           @db.Text
  det_enfermedad det_enfermedad[]
}

model historial_clinico {
  id                Int              @id @default(autoincrement())
  fecha             DateTime         @db.DateTime(0)
  descripcion       String           @db.Text
  tipo              String           @db.VarChar(255)
  url_archivos      String?          @db.VarChar(255)
  veterinario_id_fk Int?
  mascota_id_fk     Int
  cita_id_fk        Int?             @unique(map: "cita_id_fk")
  det_enfermedad    det_enfermedad[]
  det_operacion     det_operacion[]
  det_vacuna        det_vacuna[]
  veterinario       veterinario?     @relation(fields: [veterinario_id_fk], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "historial_clinico_ibfk_1")
  mascota           mascota          @relation(fields: [mascota_id_fk], references: [id], onUpdate: Restrict, map: "historial_clinico_ibfk_2")
  cita              cita?            @relation(fields: [cita_id_fk], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "historial_clinico_ibfk_3")

  @@index([veterinario_id_fk], map: "veterinario_id_fk")
  @@index([mascota_id_fk], map: "mascota_id_fk")
}

model mascota {
  id                Int                 @id @default(autoincrement())
  nombre            String              @db.VarChar(255)
  especie           String              @db.VarChar(255)
  raza              String              @db.VarChar(255)
  sexo              String              @db.VarChar(255)
  fecha_nacimiento  DateTime            @db.Date
  usuario_id_fk     Int
  url_foto          String?             @db.VarChar(255)
  cita              cita[]
  historial_clinico historial_clinico[]
  usuario           usuario             @relation(fields: [usuario_id_fk], references: [id], onUpdate: Restrict, map: "mascota_ibfk_1")

  @@index([usuario_id_fk], map: "usuario_id_fk")
}

model operacion {
  id            Int             @id @default(autoincrement())
  tipo          String          @db.VarChar(255)
  descripcion   String          @db.Text
  det_operacion det_operacion[]
}

model tratamiento {
  id                   Int            @id @default(autoincrement())
  tipo                 Int
  fecha                DateTime       @db.DateTime(0)
  fecha_fin            Int
  descripcion          String         @db.Text
  det_enfermedad_id_fk Int
  det_enfermedad       det_enfermedad @relation(fields: [det_enfermedad_id_fk], references: [id], onUpdate: Restrict, map: "tratamiento_ibfk_1")

  @@index([det_enfermedad_id_fk], map: "det_enfermedad_id_fk")
}

model usuario {
  id                   Int                    @id @default(autoincrement())
  nombre               String                 @db.VarChar(255)
  email                String                 @unique(map: "email") @db.VarChar(255)
  telefono             String                 @db.VarChar(255)
  contrasena           String                 @db.VarChar(255)
  rol                  String                 @db.VarChar(255)
  cedula               Int                    @unique(map: "cedula")
  mascota              mascota[]
  password_reset_token password_reset_token[]
}

model vacuna {
  id          Int          @id @default(autoincrement())
  nombre      String       @db.VarChar(255)
  descripcion String       @db.VarChar(255)
  det_vacuna  det_vacuna[]
}

model veterinario {
  id                Int                 @id @default(autoincrement())
  nombre            String              @db.VarChar(255)
  email             String              @db.VarChar(255)
  matricula         String              @db.VarChar(255)
  cita              cita[]
  historial_clinico historial_clinico[]
}

model cita {
  id                  Int                @id @default(autoincrement())
  fecha               DateTime           @db.DateTime(0)
  estado              String             @db.VarChar(255)
  observacion         String             @db.Text
  veterinario_id_fk   Int
  mascota_id_fk       Int
  reminder_email_sent Boolean            @default(false)
  mascota             mascota            @relation(fields: [mascota_id_fk], references: [id], onUpdate: Restrict, map: "cita_ibfk_1")
  veterinario         veterinario        @relation(fields: [veterinario_id_fk], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_cita_veterinario")
  historial_clinico   historial_clinico?

  @@index([veterinario_id_fk], map: "fk_cita_veterinario")
  @@index([mascota_id_fk], map: "mascota_id_fk")
}

model clinica {
  id        Int    @id @default(autoincrement())
  tienda    String @db.VarChar(255)
  direccion String @db.VarChar(255)
  telefono  String @db.VarChar(255)
  latitud   Float
  longitud  Float
}

model det_enfermedad {
  id                      Int               @id @default(autoincrement())
  historial_clinico_id_fk Int
  enfermedad_id_fk        Int
  fecha_inicio            DateTime          @db.DateTime(0)
  fecha_fin               DateTime          @db.DateTime(0)
  descripcion             String            @db.Text
  historial_clinico       historial_clinico @relation(fields: [historial_clinico_id_fk], references: [id], onUpdate: Restrict, map: "det_enfermedad_ibfk_1")
  enfermedad              enfermedad        @relation(fields: [enfermedad_id_fk], references: [id], onUpdate: Restrict, map: "det_enfermedad_ibfk_2")
  tratamiento             tratamiento[]

  @@unique([historial_clinico_id_fk, enfermedad_id_fk], map: "det_enfermedad_unique")
  @@index([historial_clinico_id_fk], map: "historial_clinico_id_fk")
  @@index([enfermedad_id_fk], map: "enfermedad_id_fk")
}

model det_operacion {
  id                      Int               @id @default(autoincrement())
  historial_clinico_id_fk Int
  operacion_id_fk         Int
  fecha                   DateTime          @db.DateTime(0)
  observaciones           String            @db.Text
  historial_clinico       historial_clinico @relation(fields: [historial_clinico_id_fk], references: [id], onUpdate: Restrict, map: "det_operacion_ibfk_1")
  operacion               operacion         @relation(fields: [operacion_id_fk], references: [id], onUpdate: Restrict, map: "det_operacion_ibfk_2")

  @@unique([historial_clinico_id_fk, operacion_id_fk], map: "det_operacion_unique")
  @@index([historial_clinico_id_fk], map: "historial_clinico_id_fk")
  @@index([operacion_id_fk], map: "operacion_id_fk")
}

model det_vacuna {
  id                      Int               @id @default(autoincrement())
  historial_clinico_id_fk Int
  vacuna_id_fk            Int
  fecha                   DateTime          @db.DateTime(0)
  observaciones           String            @db.Text
  historial_clinico       historial_clinico @relation(fields: [historial_clinico_id_fk], references: [id], onUpdate: Restrict, map: "det_vacuna_ibfk_1")
  vacuna                  vacuna            @relation(fields: [vacuna_id_fk], references: [id], onUpdate: Restrict, map: "det_vacuna_ibfk_2")

  @@unique([historial_clinico_id_fk, vacuna_id_fk], map: "det_vacuna_unique")
  @@index([historial_clinico_id_fk], map: "historial_clinico_id_fk")
  @@index([vacuna_id_fk], map: "vacuna_id_fk")
}

model password_reset_token {
  id            Int       @id @default(autoincrement())
  usuario_id_fk Int
  token_hash    String    @unique(map: "token_hash")
  expires_at    DateTime
  used_at       DateTime?
  created_at    DateTime  @default(now())
  ip            String?
  user_agent    String?
  usuario       usuario   @relation(fields: [usuario_id_fk], references: [id], onDelete: Cascade, map: "password_reset_token_ibfk_1")

  @@index([usuario_id_fk], map: "usuario_id_fk")
  @@index([expires_at], map: "expires_at")
}
