PORT=3000
NODE_ENV=DEV
# DB
DATABASE_URL="mysql://root:@localhost:3306/guardianpet"
# JWT
JWT_SECRET=
JWT_EXPIRES_IN=
# CORS
CORS_ORIGIN=
# CORREO
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=guardianpetnotificaciones@gmail.com
SMTP_PASS=
EMAIL_FROM="GuardianPet <guardianpetnotificaciones@gmail.com>"
RESET_TOKEN_TTL_MIN=30

# Opcional si hay proxy TLS (dev):
# SMTP_ALLOW_SELF_SIGNED=true

# Recordatorios
REMINDER_CRON=0 * * * *            # cada hora
REMINDER_AHEAD_MINUTES=1440        # 24 horas
APP_TZ=America/Bogota              # para formatear texto de fecha

# Para UID único del .ics (cambia a tu dominio si tienes)
ICS_UID_DOMAIN=guardianpet.local

OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=
# Opcional: timeout en ms
OLLAMA_TIMEOUT_MS=45000
